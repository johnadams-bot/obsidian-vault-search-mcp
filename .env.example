# ===== 必填：知识库路径 =====
# 待检索的 Obsidian vault（或任意存放 .md 的目录）根路径
VAULT_PATH=/absolute/path/to/your/vault

# 选填：Obsidian 库名，用于生成 obsidian:// 深链；留空则改用 file:// 链接
VAULT_NAME=MyVault

# 选填：索引数据库路径；留空默认脚本同目录 vault_index.db
# INDEX_DB=/absolute/path/to/vault_index.db

# 选填：单次检索返回条数
TOP_K=10

# 选填：配置 LLM 且设为 true 时，对 BM25 召回结果做语义重排
ENABLE_RERANK=false

# ===== 选填：大模型（不填则仅本地 BM25 召回，aggregate 不可用）=====
# 支持任何 OpenAI 兼容 /chat/completions 协议的服务
LLM_PROVIDER=openai          # 仅用于显示：openai / deepseek / qwen / glm / local
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here # 务必替换为真实 key，且不要提交本文件
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
